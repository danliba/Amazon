    "# Measure particle loss\n",
    "ds = xr.open_zarr(out_path)\n",
    "# a trajectory is \"lost\" if all lat are NaN or last obs is NaN\n",
    "# Simple metric: final obs NaN per trajectory\n",
    "final_nan = ds.lat.isnull().isel(obs=-1)\n",
    "lost = int(final_nan.sum().item())\n",
    "total = int(ds.dims.get(\"trajectory\", ds.sizes.get(\"trajectory\")))\n",
    "pct = 100.0 * lost / total if total else np.nan\n",
    "\n",
    "# Append to a CSV summary (safe for multiple jobs if you write separate files and merge later)\n",
    "summary_row = f\"{args.seed},{args.time_step_minutes},{args.out_put_step_hours},{lost},{total},{pct:.3f}\\n\"\n",
    "summary_file = os.path.join(args.outdir, \"summary_seed{}_dt{}m_out{}h.csv\".format(\n",
    "    args.seed, args.time_step_minutes, args.out_put_step_hours))\n",
    "with open(summary_file, \"w\") as f:\n",
    "    f.write(\"seed,dt_min,out_h,lost,total,pct_lost\\n\")\n",
    "    f.write(summary_row)\n",
    "\n",
    "# Also print to stdout for SLURM logs\n",
    "print(summary_row.strip())"
   ]
