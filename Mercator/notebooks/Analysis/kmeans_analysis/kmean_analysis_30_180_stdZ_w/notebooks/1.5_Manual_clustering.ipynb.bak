      "GROUP_MAP = {0: 2, 1: 12, 2: 4, 3: 7, 4: 13, 5: 2, 6: 8, 7: 5, 8: 14, 9: 16, 10: 4, 11: 6, 12: 8, 13: 5, 14: 14, 15: 15, 16: 0, 17: 7, 18: 10, 19: 15, 20: 2, 21: 11, 22: 2, 23: 5, 24: 6, 25: 15, 26: 9, 27: 13, 28: 5, 29: 5, 30: 8, 31: 0, 32: 10, 33: 3, 34: 4, 35: 1, 36: 2, 37: 15, 38: 5, 39: 2, 40: 4, 41: 15, 42: 2, 43: 7, 44: 8, 45: 14, 46: 5, 47: 9, 48: 4, 49: 12}\n",
